{
  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "Microsoft.AspNetCore": "Error"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ECommSQLite": "Data Source=ECommBackend.db"
  },
  "JWTSettings": {
    "SecretKey": "papasecretkeyislicked123",
    "RefreshKey": "refreshkeyislicked098",
    "Issuer": "ECommBackend",
    "Audience": "ECommFrontend",
    "AccessKeyTimeLineMinutes": 5,
    "RefreshKeyTimeLineDays": 9
  },
  
    "Serilog": {
      "MinimumLevel": {
        "Default": "Information",
        "Override": {
          "Microsoft": "Warning",
          "System": "Warning"
        }
      },
      "Enrich": [ "FromLogContext", "WithMachineName" ],
      "WriteTo": [
        {
          "Name": "Console",
          "Args": {
            "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties}{NewLine}{Exception}"
          }
        }
      ]
    }
  
}
